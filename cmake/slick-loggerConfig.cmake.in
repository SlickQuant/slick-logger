@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(slick-queue 2.0.0 CONFIG)

include("${CMAKE_CURRENT_LIST_DIR}/slick-loggerTargets.cmake")

if(DEFINED SLICK_LOGGER_ENABLE_SOURCE_LOCATION AND NOT SLICK_LOGGER_ENABLE_SOURCE_LOCATION)
    target_compile_definitions(slick::logger INTERFACE SLICK_LOGGER_ENABLE_SOURCE_LOCATION=0)
endif()

check_required_components(slick-logger)
